{
    "name": "php-baremetal/spec",
    "description": "Shared model of the php-baremetal build manifest and the SDK driver contract.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gianfrancesco Aurecchia",
            "email": "gianfri@php-baremetal.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "phpunit/phpunit": "Required by Testing\\DriverConformanceTestCase"
    },
    "autoload": {
        "psr-4": { "PhpBaremetal\\Spec\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PhpBaremetal\\Spec\\Tests\\": "tests/" }
    }
}
